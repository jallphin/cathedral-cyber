---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className = "" } = Astro.props;

const base =
  "group relative bg-bg-surface border border-stone p-6 md:p-8 transition-all duration-300 ease-out hover:border-stone-light hover:bg-bg-raised";
const hoverLine =
  "absolute top-0 left-0 right-0 h-px bg-accent opacity-0 group-hover:opacity-100 transition-opacity duration-300";

const Tag = href ? "a" : "div";
---

<Tag href={href} class={`${base} ${className}`}>
  <div class={hoverLine} aria-hidden="true"></div>
  <slot />
</Tag>
