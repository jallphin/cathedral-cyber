---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class={`
  group relative bg-bg-secondary border border-white/5 rounded-xl p-6 md:p-8
  transition-all duration-300 ease-out
  hover:-translate-y-1 hover:glow-border hover:border-accent-primary/30
  ${className}
`}>
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-primary to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />
  <slot />
</div>
