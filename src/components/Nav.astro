---
const links = [
  { href: "#about", label: "About" },
  { href: "#founder", label: "Founder" },
  { href: "#capabilities", label: "Capabilities" },
  { href: "#arsenal", label: "Arsenal" },
  { href: "#contact", label: "Contact" },
];
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 border-b border-stone bg-bg-primary/90 backdrop-blur-md">
  <div class="container-site">
    <div class="flex items-center justify-between h-16">
      <a href="#" class="flex items-center h-8 hover:opacity-90 transition-opacity">
        <img
          src="/assets/images/wordmark.png"
          alt="Cathedral Cyber"
          class="h-full w-auto object-contain"
          loading="eager"
          decoding="async"
        />
      </a>
      <div class="hidden md:flex items-center gap-8">
        {links.map(link => (
          <a
            href={link.href}
            class="nav-link text-sm font-medium text-text-secondary hover:text-text-primary transition-colors relative group"
            data-section={link.href.replace('#', '')}
          >
            {link.label}
            <span class="absolute -bottom-1 left-0 w-0 h-px bg-accent transition-all duration-300 group-hover:w-full" />
          </a>
        ))}
      </div>
      <button
        id="menu-btn"
        class="md:hidden text-text-primary p-2 -mr-2 border border-stone hover:border-stone-light transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <line x1="4" x2="20" y1="7" y2="7"/>
          <line x1="4" x2="20" y1="12" y2="12"/>
          <line x1="4" x2="20" y1="17" y2="17"/>
        </svg>
        <svg id="icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
          <line x1="5" x2="19" y1="5" y2="19"/>
          <line x1="19" x2="5" y1="5" y2="19"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-stone bg-bg-primary">
    <div class="container-site py-6 space-y-1">
      {links.map(link => (
        <a
          href={link.href}
          class="mobile-link block px-3 py-3 text-base font-medium text-text-secondary hover:text-text-primary hover:bg-bg-raised transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  (function () {
    const btn = document.getElementById('menu-btn');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const links = document.querySelectorAll('.mobile-link');
    const navLinks = document.querySelectorAll('.nav-link');
    if (!btn || !menu || !iconOpen || !iconClose) return;

    function toggle() {
      const isHidden = menu.classList.toggle('hidden');
      const isOpen = !isHidden;
      btn.setAttribute('aria-expanded', String(isOpen));
      iconOpen.classList.toggle('hidden', isOpen);
      iconClose.classList.toggle('hidden', !isOpen);
      document.body.classList.toggle('overflow-hidden', isOpen);
    }

    btn.addEventListener('click', toggle);

    links.forEach((a) => {
      a.addEventListener('click', () => {
        if (!menu.classList.contains('hidden')) toggle();
      });
    });

    document.addEventListener('click', (e) => {
      const nav = document.getElementById('main-nav');
      if (nav && !nav.contains(e.target) && !menu.classList.contains('hidden')) {
        toggle();
      }
    });

    // Simple scroll spy for desktop nav
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              navLinks.forEach((link) => {
                link.classList.toggle('text-accent', link.dataset.section === id);
                link.classList.toggle('text-text-secondary', link.dataset.section !== id);
              });
            }
          });
        },
        { rootMargin: '-50% 0px -50% 0px', threshold: 0 }
      );

      document.querySelectorAll('section[id]').forEach((section) => {
        observer.observe(section);
      });
    }
  })();
</script>
