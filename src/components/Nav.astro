---
const links = [
  { href: "#about", label: "About" },
  { href: "#services", label: "Services" },
  { href: "#arsenal", label: "Arsenal" },
  { href: "#contact", label: "Contact" },
];
---

<nav class="nav" id="main-nav">
  <div class="container nav-inner">
    <a href="#" class="nav-brand">CATHEDRAL CYBER</a>
    <div class="nav-links" id="desktop-links">
      {links.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <span id="toggle-label">TERM</span>
      </button>
    </div>
    <button class="mobile-menu-btn" id="menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span id="menu-icon">☰</span>
    </button>
  </div>
  <div class="mobile-menu container" id="mobile-menu">
    {links.map(link => (
      <a href={link.href} class="nav-link mobile-link">{link.label}</a>
    ))}
    <button class="theme-toggle" id="mobile-theme-toggle" aria-label="Toggle theme">
      <span id="mobile-toggle-label">TERM</span>
    </button>
  </div>
</nav>

<script>
  (function () {
    var toggle = document.getElementById('theme-toggle');
    var mobileToggle = document.getElementById('mobile-theme-toggle');
    var label = document.getElementById('toggle-label');
    var mobileLabel = document.getElementById('mobile-toggle-label');
    var fontLink = document.getElementById('theme-fonts');
    var root = document.documentElement;

    function setTheme(name) {
      root.setAttribute('data-theme', name);
      localStorage.setItem('cc-theme', name);
      var text = name === 'forge' ? 'FORGE' : 'TERM';
      if (label) label.textContent = text;
      if (mobileLabel) mobileLabel.textContent = text;
      if (fontLink) {
        if (name === 'forge') {
          fontLink.href = "https://fonts.googleapis.com/css2?family=Bitter:wght@400;700\u0026family=Source+Sans+Pro:wght@400;600\u0026display=swap";
        } else {
          fontLink.href = "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700\u0026family=IBM+Plex+Sans:wght@400;500\u0026display=swap";
        }
      }
    }

    function cycle() {
      var current = root.getAttribute('data-theme');
      setTheme(current === 'forge' ? 'terminal' : 'forge');
    }

    if (toggle) toggle.addEventListener('click', cycle);
    if (mobileToggle) mobileToggle.addEventListener('click', cycle);

    // init label
    var stored = localStorage.getItem('cc-theme') || 'terminal';
    var text = stored === 'forge' ? 'FORGE' : 'TERM';
    if (label) label.textContent = text;
    if (mobileLabel) mobileLabel.textContent = text;
  })();
</script>

<script>
  (function () {
    var btn = document.getElementById('menu-btn');
    var menu = document.getElementById('mobile-menu');
    var icon = document.getElementById('menu-icon');
    if (!btn || !menu || !icon) return;

    function toggle() {
      var open = menu.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
      icon.textContent = open ? '×' : '☰';
      document.body.style.overflow = open ? 'hidden' : '';
    }

    btn.addEventListener('click', toggle);

    document.querySelectorAll('.mobile-link').forEach(function (a) {
      a.addEventListener('click', function () {
        if (menu.classList.contains('open')) toggle();
      });
    });

    document.addEventListener('click', function (e) {
      var nav = document.getElementById('main-nav');
      if (nav && !nav.contains(e.target) && menu.classList.contains('open')) {
        toggle();
      }
    });
  })();
</script>
