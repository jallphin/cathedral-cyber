---
interface Props {
  title: string;
  subtitle?: string;
  id?: string;
}
const { title, subtitle, id } = Astro.props;
---
<div class="mb-12 md:mb-16 text-center" id={id}>
  <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-gradient uppercase">{title}</h2>
  {subtitle && (
    <p class="mt-4 text-text-secondary text-lg md:text-xl max-w-2xl mx-auto">{subtitle}</p>
  )}
</div>
