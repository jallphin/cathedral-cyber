---
interface Props {
  text: string;
  variant?: "default" | "accent" | "active";
}
const { text, variant = "default" } = Astro.props;
const base = "inline-flex items-center px-2.5 py-0.5 text-xs font-medium border font-mono";
const styles = {
  default: "border-stone text-text-secondary bg-bg-raised",
  accent: "border-accent text-accent bg-accent/5",
  active: "border-stone-light text-text-secondary bg-bg-raised",
};
---
<span class={`${base} ${styles[variant]}`}>{text}</span>
