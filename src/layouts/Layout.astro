---
const { title = "CATHEDRAL CYBER | Objective-Driven Offensive Security" } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="terminal">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Objective-driven offensive security. Red team operations, penetration testing, and compliance monitoring." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link id="theme-fonts" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=IBM+Plex+Sans:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230a0a0a'/%3E%3Ctext x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' font-family='monospace' font-size='48' font-weight='700' fill='%2300d4ff'%3ECC%3C/text%3E%3C/svg%3E" />
  <style is:global>
    @import "../styles/global.css";
  </style>
  <script is:inline>
    (function() {
      var stored = localStorage.getItem('cc-theme');
      var root = document.documentElement;
      var fontLink = document.getElementById('theme-fonts');
      if (stored === 'forge') {
        root.setAttribute('data-theme', 'forge');
        if (fontLink) {
          fontLink.href = "https://fonts.googleapis.com/css2?family=Bitter:wght@400;700&family=Source+Sans+Pro:wght@400;600&display=swap";
        }
      } else {
        root.setAttribute('data-theme', 'terminal');
        if (fontLink) {
          fontLink.href = "https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=IBM+Plex+Sans:wght@400;500&display=swap";
        }
      }
    })();
  </script>
</head>
<body>
  <slot />
</body>
</html>
