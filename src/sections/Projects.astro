---
interface Project {
  name: string;
  description: string;
  tags: string[];
  status: string;
  license: string;
  link?: string;
}

const projects: Project[] = [
  {
    name: "Wraith",
    description: "Real-time shell session capture. Every keystroke timestamped, AI-synthesized to MITRE ATT\u0026CK. The op is the report.",
    tags: ["Go", "SQLite", "Bubbletea", "Anthropic/OpenAI"],
    status: "Active",
    license: "Open Source",
    link: "https://github.com/jallphin/wraith",
  },
  {
    name: "Spitfire",
    description: "Self-contained red team infrastructure. Deploy, operate, destroy. Built for constrained environments with no reach-back.",
    tags: ["Docker", "Shell", "HTML", "Kali Linux"],
    status: "Active",
    license: "Open Source",
    link: "https://github.com/jallphin/spitfire",
  },
  {
    name: "HELICS",
    description: "Blockchain-anchored compliance monitoring. Hash-based drift detection on a Hyperledger ledger. If your security state changes, you know immediately.",
    tags: ["Hyperledger", "SCAP", "STIG"],
    status: "Active",
    license: "Open Source",
  },
  {
    name: "Haystackr",
    description: "Open-source terminal-first CAN bus diagnostics. UDS-based vehicle network discovery on custom hardware. Cathedral's contribution to the right-to-repair community.",
    tags: ["C++", "Teensy 4.1", "CAN", "UDS"],
    status: "Active",
    license: "Open Source",
  },
];
---

<section id="arsenal" class="section">
  <hr class="section-divider" />
  <div class="container">
    <div class="grid-1">
      {projects.map((p) => (
        <div class="card arsenal-card">
          <div style="display:flex; align-items:baseline; justify-content:space-between; gap:1rem; flex-wrap:wrap;">
            <h3 style="font-family: var(--font-heading); font-size: 1.15rem; margin:0;">{p.name}</h3>
            {p.link && (
              <a href={p.link} target="_blank" rel="noopener noreferrer" class="link-plain" style="font-family: var(--font-heading); font-size: 0.8rem;">github.com/jallphin/{p.name.toLowerCase()} →</a>
            )}
          </div>
          <p style="margin-top: 0.75rem; font-size: 0.95rem; line-height: 1.7; color: var(--text-secondary);">{p.description}</p>
          <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
            {p.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
            <span class="status-tag">{p.status}</span>
            <span class="status-tag">{p.license}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
