---
interface Project {
  name: string;
  description: string;
  tags: string[];
  status: string;
  license: string;
  link?: string;
}

const projects: Project[] = [
  {
    name: "Wraith",
    description: "Real-time shell session capture. Every keystroke timestamped, AI-synthesized to MITRE ATT&CK. The op is the report.",
    tags: ["Go", "SQLite", "Bubbletea", "Anthropic/OpenAI"],
    status: "Active",
    license: "Open Source",
    link: "https://github.com/jallphin/wraith",
  },
  {
    name: "Spitfire",
    description: "Self-contained red team infrastructure. Deploy, operate, destroy. Built for constrained environments with no reach-back.",
    tags: ["Docker", "Shell", "HTML", "Kali Linux"],
    status: "Active",
    license: "Open Source",
    link: "https://github.com/jallphin/spitfire",
  },
  {
    name: "HELICS",
    description: "Blockchain-anchored compliance monitoring. Hash-based drift detection on a Hyperledger ledger. If your security state changes, you know immediately.",
    tags: ["Hyperledger", "SCAP", "STIG"],
    status: "Active",
    license: "Open Source",
  },
  {
    name: "Haystackr",
    description: "Open-source terminal-first CAN bus diagnostics. UDS-based vehicle network discovery on custom hardware. Cathedral's contribution to the right-to-repair community.",
    tags: ["C++", "Teensy 4.1", "CAN", "UDS"],
    status: "Active",
    license: "Open Source",
  },
];
---

<section id="arsenal" class="section">
  <hr class="section-divider" />
  <div class="container">
    <div class="grid-1 reveal-stagger">
      {projects.map((p) => (
        <div class="card arsenal-card reveal">
          <div class="arsenal-header">
            <h3 class="card-title" style="margin-bottom: 0;">{p.name}</h3>
            {p.link && (
              <a href={p.link} target="_blank" rel="noopener noreferrer" class="link-plain arsenal-link">
                github.com/jallphin/{p.name.toLowerCase()} &rarr;
              </a>
            )}
          </div>
          <p class="card-body" style="margin-top: 0.75rem;">{p.description}</p>
          <div class="arsenal-tags">
            {p.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
            <span class="status-tag">{p.status}</span>
            <span class="status-tag">{p.license}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .arsenal-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .arsenal-link {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }
  .arsenal-tags {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
</style>
