---
import SectionTitle from "../components/SectionTitle.astro";
import ToolCard from "../components/ToolCard.astro";

interface Project {
  name: string;
  tagline: string;
  description: string;
  tech: string[];
  link?: string;
  status?: "public" | "private";
  stars?: number;
  forks?: number;
}

const projects: Project[] = [
  {
    name: "WRAITH / RAZIEL",
    tagline: "Passive shell session capture",
    description:
      "Transparent PTY wrapper that timestamps every keystroke to SQLite. AI synthesis clusters activity by target and phase, maps to MITRE ATT\u0026CK, and exports structured findings. Renaming to Raziel (raz CLI) — coming soon.",
    tech: ["Go", "SQLite", "Bubbletea", "AI synthesis"],
    link: "https://github.com/jallphin/wraith",
    status: "private" as const,
  },
  {
    name: "SPITFIRE",
    tagline: "Deployable nerve center",
    description:
      "Portable Docker-based red team server. Matrix Synapse, Covenant C2, IVRE, Gitea, CyberChef, Nextcloud — deploy, operate, destroy.",
    tech: ["Docker", "Shell", "Kali Linux"],
    link: "https://github.com/jallphin/spitfire",
    status: "public" as const,
    stars: 16,
    forks: 8,
  },
  {
    name: "INTEGRITY CHAIN",
    tagline: "Blockchain-based integrity monitoring",
    description:
      "Tamper-evident system baselines using distributed ledger technology. STIG compliance fingerprints anchored to blockchain — proving what changed, when, and by whom. Research-backed, field-tested.",
    tech: ["Hyperledger Fabric", "SCAP", "STIG", "Blockchain"],
    status: "private" as const,
  },
  {
    name: "COBALT STRIKE ARMORY",
    tagline: "Evasive payload tooling",
    description:
      "Private collection of Cobalt Strike scripts, BOFs, profiles, and evasive payload tooling developed for authorized red team engagements.",
    tech: ["Cobalt Strike", "BOF", "Aggressor", "C/C#"],
    status: "private" as const,
  },
];
---

<section id="arsenal" class="section-padding border-t border-stone">
  <div class="container-site">
    <SectionTitle
      eyebrow=">_ Arsenal"
      title="Tools forged in the field"
      subtitle="Tooling developed during live engagements."
    />

    <div class="grid lg:grid-cols-2 gap-px bg-stone border border-stone">
      {
        projects.map((p) => (
          <ToolCard
            name={p.name}
            tagline={p.tagline}
            description={p.description}
            tech={p.tech}
            link={p.link}
            status={p.status}
            stars={p.stars}
            forks={p.forks}
          />
        ))
      }
    </div>
  </div>
</section>
