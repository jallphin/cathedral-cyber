---
import Button from "../components/Button.astro";
---

<section
  id="hero"
  class="relative min-h-screen flex flex-col justify-center pb-16 md:pb-24 pt-32 overflow-hidden"
>
  <div class="container-site relative z-10">
    <div class="max-w-4xl mx-auto text-center">
      <img
        src="/assets/images/logo-primary.png"
        alt="Cathedral Cyber — Engineered like stone. Operated like a red team."
        class="w-full max-w-[1042px] h-auto mb-6 mx-auto hero-reveal"
        loading="eager"
        decoding="async"
      />

      <p class="mt-8 text-lg md:text-xl text-text-secondary max-w-2xl mx-auto leading-relaxed hero-reveal">
        Cathedral Cyber is a small, veteran-owned red team and penetration testing consultancy for DoD and federal clients. We find the gaps before your adversaries do.
      </p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-4 hero-reveal">
        <Button href="#contact" variant="primary">START AN ENGAGEMENT</Button>
        <Button href="#capabilities" variant="ghost">VIEW CAPABILITIES</Button>
      </div>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3 text-text-muted hero-reveal">
    <span class="font-mono text-[10px] tracking-[0.2em] uppercase">Scroll</span>
    <div class="w-px h-12 bg-stone relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1/2 bg-accent animate-scroll-line"></div>
    </div>
  </div>

  <style>
    .hero-reveal {
      opacity: 0;
      transform: translateY(24px);
      animation: reveal 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .hero-reveal:nth-child(1) { animation-delay: 0.1s; }
    .hero-reveal:nth-child(2) { animation-delay: 0.2s; }
    .hero-reveal:nth-child(3) { animation-delay: 0.35s; }
    .hero-reveal:nth-child(4) { animation-delay: 0.5s; }
    .hero-reveal:nth-child(5) { animation-delay: 0.7s; }

    @keyframes reveal {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes scroll-line {
      0% { transform: translateY(-100%); }
      100% { transform: translateY(200%); }
    }
    .animate-scroll-line {
      animation: scroll-line 2.5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
      .hero-reveal {
        opacity: 1;
        transform: none;
        animation: none;
      }
      .animate-scroll-line {
        animation: none;
      }
    }
  </style>
</section>
