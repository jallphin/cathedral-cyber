---
import SectionTitle from "../components/SectionTitle.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";

const capabilities = [
  {
    icon: "target" as const,
    title: "Red Team Operations",
    description:
      "Full-scope adversary simulation against live environments. We play the role of your most capable threat.",
  },
  {
    icon: "lock" as const,
    title: "Penetration Testing",
    description:
      "Network, application, and physical assessments. Scoped engagements with actionable reporting.",
  },
  {
    icon: "shield" as const,
    title: "Compliance Gap Assessment",
    description:
      "CMMC and NIST 800-171 gap assessments. We identify control failures; your team owns the remediation and RMF package.",
  },
  {
    icon: "globe" as const,
    title: "Threat Modeling",
    description:
      "Identify your highest-value targets before an adversary does. Architecture review and kill-chain mapping.",
  },
  {
    icon: "grid" as const,
    title: "Security Architecture",
    description:
      "Design review for systems built to resist nation-state-level persistence and lateral movement.",
  },
  {
    icon: "users" as const,
    title: "Training & Workshops",
    description:
      "Hands-on red team operator training. Purple team exercises. Detection engineering workshops.",
  },
];
---

<section id="capabilities" class="section-padding border-t border-stone">
  <div class="container-site">
    <SectionTitle
      eyebrow=">_ Capabilities"
      title="What we do"
      subtitle="Six disciplines. One adversarial mindset."
    />

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-stone border border-stone">
      {
        capabilities.map((cap) => (
          <Card class="bg-bg-surface">
            <Icon name={cap.icon} class="w-6 h-6 text-text-muted group-hover:text-accent transition-colors" />
            <h3 class="mt-5 font-display text-lg font-bold text-text-primary">{cap.title}</h3>
            <p class="mt-2 text-text-secondary text-sm leading-relaxed">{cap.description}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
