---
---
<section id="contact" class="section">
  <hr class="section-divider" />
  <div class="container" style="max-width: 640px;">
    <p class="contact-intro reveal">Ready to scope an engagement or want to learn more about what we do? Reach out.</p>

    <form id="contact-form" class="reveal">
      <div class="form-group">
        <label for="org" class="form-label">Organization</label>
        <input id="org" name="org" type="text" required class="form-input" placeholder="Acme Corp" />
      </div>

      <div class="form-row">
        <div class="form-group half">
          <label for="name" class="form-label">Point of Contact</label>
          <input id="name" name="name" type="text" required class="form-input" placeholder="Jane Doe" />
        </div>
        <div class="form-group half">
          <label for="email" class="form-label">Email</label>
          <input id="email" name="email" type="email" required class="form-input" placeholder="jane@acme.corp" />
        </div>
      </div>

      <div class="form-group">
        <label for="notes" class="form-label">Scope / Notes</label>
        <textarea id="notes" name="notes" class="form-input" placeholder="Describe the engagement scope, timeline, or any special requirements..."></textarea>
      </div>

      <button type="submit" class="btn" style="margin-top: 0.75rem;">TRANSMIT</button>
    </form>

    <p class="contact-disclaimer reveal">No data is stored or transmitted through any server. Clicking TRANSMIT opens your default email client.</p>
  </div>
</section>

<style>
  .contact-intro {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 2rem;
  }
  .contact-disclaimer {
    margin-top: 1.75rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-heading);
    letter-spacing: 0.02em;
  }
</style>

<script>
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var data = new FormData(form as HTMLFormElement);
      var org = String(data.get('org') || '').trim();
      var name = String(data.get('name') || '').trim();
      var email = String(data.get('email') || '').trim();
      var notes = String(data.get('notes') || '').trim();
      var subject = encodeURIComponent('Inquiry from cathedralcyber.com');
      var body = encodeURIComponent(
        'Organization: ' + org + '\n' +
        'Contact: ' + name + '\n' +
        'Email: ' + email + '\n\n' +
        'Scope / Notes:\n' + (notes || 'N/A')
      );
      window.location.href = 'mailto:contact@cathedralcyber.com?subject=' + subject + '&body=' + body;
    });
  })();
</script>
