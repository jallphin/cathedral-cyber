---
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/Button.astro";
---

<section id="contact" class="section-padding border-t border-stone">
  <div class="container-site">
    <div class="max-w-3xl mx-auto">
      <SectionTitle
        eyebrow=">_ Establish Contact"
        title="Engage"
        subtitle="Tell me what you're defending. I respond within two business days."
      />

      <form id="contact-form" class="bg-bg-surface border border-stone p-6 md:p-8 space-y-6" novalidate>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <label for="org" class="block text-xs font-medium text-text-secondary font-mono uppercase tracking-wider">
              Organization <span class="text-accent">*</span>
            </label>
            <input
              id="org"
              name="org"
              type="text"
              required
              class="mt-2 w-full bg-bg-primary border border-stone px-4 py-3 text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors"
              placeholder="Acme Corp"
            />
            <p class="error-msg mt-1 text-xs text-danger hidden" data-for="org">Organization is required.</p>
          </div>
          <div>
            <label for="name" class="block text-xs font-medium text-text-secondary font-mono uppercase tracking-wider">
              Point of Contact <span class="text-accent">*</span>
            </label>
            <input
              id="name"
              name="name"
              type="text"
              required
              class="mt-2 w-full bg-bg-primary border border-stone px-4 py-3 text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors"
              placeholder="Jane Doe"
            />
            <p class="error-msg mt-1 text-xs text-danger hidden" data-for="name">Name is required.</p>
          </div>
        </div>

        <div>
          <label for="email" class="block text-xs font-medium text-text-secondary font-mono uppercase tracking-wider">
            Email <span class="text-accent">*</span>
          </label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="mt-2 w-full bg-bg-primary border border-stone px-4 py-3 text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors"
            placeholder="jane@acme.corp"
          />
          <p class="error-msg mt-1 text-xs text-danger hidden" data-for="email">A valid email is required.</p>
        </div>

        <div>
          <label for="notes" class="block text-xs font-medium text-text-secondary font-mono uppercase tracking-wider">Scope / Notes</label>
          <textarea
            id="notes"
            name="notes"
            rows="5"
            class="mt-2 w-full bg-bg-primary border border-stone px-4 py-3 text-text-primary placeholder:text-text-muted focus:outline-none focus:border-accent transition-colors"
            placeholder="Describe the engagement scope, timeline, or any special requirements..."
          ></textarea>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-2">
          <Button type="submit" variant="primary">TRANSMIT >_</Button>
          <p class="text-xs text-text-muted">
            Or email directly: <a href="mailto:contact@cathedralcyber.com" class="text-accent hover:underline">contact@cathedralcyber.com</a>
          </p>
        </div>
      </form>

      <div id="contact-success" class="hidden bg-bg-surface border border-stone p-8 md:p-12 text-center">
        <div class="w-12 h-12 mx-auto border border-accent flex items-center justify-center text-accent mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <polyline points="20 6 9 17 4 12" />
          </svg>
        </div>
        <h3 class="font-display text-2xl font-bold text-text-primary">Transmission logged</h3>
        <p class="mt-3 text-text-secondary">
          Your inquiry has been prepared. We'll respond within two business days.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const form = document.getElementById('contact-form');
    const success = document.getElementById('contact-success');
    if (!form || !success) return;

    const fields = ['org', 'name', 'email'];

    function showError(id: string, show: boolean) {
      const el = document.getElementById(id);
      const msg = form.querySelector(`[data-for="${id}"]`);
      el?.classList.toggle('border-danger', show);
      el?.classList.toggle('border-stone', !show);
      msg?.classList.toggle('hidden', !show);
    }

    function validate() {
      let isValid = true;
      fields.forEach((id) => {
        const el = document.getElementById(id) as HTMLInputElement | null;
        const value = el?.value.trim() ?? '';
        let fieldValid = value.length > 0;
        if (id === 'email' && fieldValid) {
          fieldValid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
        }
        showError(id, !fieldValid);
        if (!fieldValid) isValid = false;
      });
      return isValid;
    }

    fields.forEach((id) => {
      const el = document.getElementById(id);
      el?.addEventListener('input', () => showError(id, false));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!validate()) return;

      const data = new FormData(form);
      const org = String(data.get('org') ?? '').trim();
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const notes = String(data.get('notes') ?? '').trim();
      const subject = encodeURIComponent(`Contact inquiry from ${org} — ${name}`);
      const body = encodeURIComponent(
        `Organization: ${org}\n` +
        `Contact: ${name}\n` +
        `Email: ${email}\n\n` +
        `Scope / Notes:\n${notes || 'N/A'}`
      );

      form.classList.add('hidden');
      success.classList.remove('hidden');
      window.location.href = `mailto:contact@cathedralcyber.com?subject=${subject}&body=${body}`;
    });
  })();
</script>
